# Every env var the server reads. Validated at boot (src/config/env.validation.ts).
# Copy to .env (git-ignored). The defaults below match the local infrastructure
# started by scripts/Setup.ps1 (infra/docker-compose.yml).

# development | production | test (default: development)
NODE_ENV=development

# HTTP port (default: 3000)
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# PostGIS connection (all REQUIRED except DB_PORT, default: 5434).
# The PostGIS container is published on 5434, not the usual 5432
# (infra/docker-compose.yml), so it doesn't clash with a PostgreSQL installed
# on Windows.
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=Aa123456
DB_NAME=imunim

# GeoServer: WFS-T writes and the training-area spatial check (all REQUIRED).
# GEOSERVER_NAMESPACE_URI must match the workspace's namespace URI
# (NamespaceUri in scripts/config.psd1).
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USERNAME=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=imunim
GEOSERVER_NAMESPACE_URI=http://imunim
