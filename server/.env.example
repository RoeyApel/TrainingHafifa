# Every env var the server reads. Validated at boot (src/config/env.validation.ts).
# Copy to .env (git-ignored). The defaults below match the local infrastructure
# started by scripts/Setup.ps1 (infra/docker-compose.yml).

# development | production | test (default: development)
NODE_ENV=development

# HTTP port (default: 3000)
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# PostGIS connection (all REQUIRED except DB_PORT, default: 5432).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Aa123456
DB_NAME=imunim

# GeoServer, used for WFS-T writes (all REQUIRED).
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USERNAME=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=imunim
